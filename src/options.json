{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context": {
      "description": "A string indicating the root of your files.",
      "type": "string"
    },
    "lintOnStart": {
      "description": "Whether the first compilation lints every file it covers. `false` leaves a watch run reporting only the modules webpack rebuilds; a build has nothing but a first compilation, so it always lints.",
      "type": "boolean"
    },
    "checks": {
      "description": "The checks to run, each with the options only it understands.",
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "./entry-options.json"
          }
        ]
      }
    },
    "cache": {
      "$ref": "./shared-options.json#/properties/cache"
    },
    "cacheLocation": {
      "$ref": "./shared-options.json#/properties/cacheLocation"
    },
    "exclude": {
      "$ref": "./shared-options.json#/properties/exclude"
    },
    "extensions": {
      "$ref": "./shared-options.json#/properties/extensions"
    },
    "files": {
      "$ref": "./shared-options.json#/properties/files"
    },
    "fix": {
      "$ref": "./shared-options.json#/properties/fix"
    },
    "formatter": {
      "$ref": "./shared-options.json#/properties/formatter"
    },
    "ignoreDiagnostics": {
      "$ref": "./shared-options.json#/properties/ignoreDiagnostics"
    },
    "outputReport": {
      "$ref": "./shared-options.json#/properties/outputReport"
    },
    "reportAs": {
      "$ref": "./shared-options.json#/properties/reportAs"
    },
    "resourceQueryExclude": {
      "$ref": "./shared-options.json#/properties/resourceQueryExclude"
    },
    "threads": {
      "$ref": "./shared-options.json#/properties/threads"
    }
  },
  "required": ["checks"]
}
